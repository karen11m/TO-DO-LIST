<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="32dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nueva Tarea"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:letterSpacing="0.3"
            android:layout_marginBottom="28dp" />

        <!-- Tarjeta -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF"
            android:padding="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="36dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Campo Título -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Título"
                    app:boxStrokeColor="#26A69A"
                    app:boxStrokeErrorColor="#FF5252"
                    app:boxBackgroundColor="#F0F2F5"
                    app:boxBackgroundMode="filled"
                    app:hintTextColor="#000000">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textColorHint="#757575"
                        android:textSize="16sp"
                        android:inputType="textCapSentences"
                        android:paddingVertical="12dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Descripción -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="Descripción"
                    app:boxStrokeColor="#26A69A"
                    app:boxStrokeErrorColor="#FF5252"
                    app:boxBackgroundColor="#F0F2F5"
                    app:boxBackgroundMode="filled"
                    app:hintTextColor="#000000">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textColorHint="#757575"
                        android:textSize="16sp"
                        android:inputType="textMultiLine"
                        android:minLines="4"
                        android:paddingVertical="12dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Divisor -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:background="#E8ECF1"
                    android:layout_marginVertical="24dp" />

                <!-- Prioridad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prioridad"
                        android:textSize="14sp"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:layout_marginEnd="16dp"
                        android:minWidth="90dp" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spPrioridad"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_spinner_professional"
                        android:padding="14dp"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:entries="@array/prioridades" />

                </LinearLayout>

                <!-- Categoría -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Categoría"
                        android:textSize="14sp"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:layout_marginEnd="16dp"
                        android:minWidth="90dp" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spCategoria"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_spinner_professional"
                        android:padding="14dp"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:entries="@array/categorias" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Guardar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:text="GUARDAR TAREA"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="1.2"
            app:cornerRadius="32dp"
            android:backgroundTint="#26A69A"
            app:elevation="6dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>