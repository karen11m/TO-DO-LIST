<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0A192F"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:titleTextAppearance="@style/TextAppearance.AppCompat.Widget.ActionBar.Title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card de Resumen -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvEstadoGeneral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Cargando..."
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A2E"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvPorcentaje"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 0%"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#26A69A"
                        android:layout_marginBottom="8dp" />

                    <ProgressBar
                        android:id="@+id/progressBarStats"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#26A69A"
                        android:progressBackgroundTint="#E8ECF1" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card de Detalles -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📋 Detalles"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A2E"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvTotalTareas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📋 Total: 0"
                        android:textSize="16sp"
                        android:textColor="#1A1A2E"
                        android:paddingVertical="6dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E8ECF1" />

                    <TextView
                        android:id="@+id/tvCompletadas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✅ Completadas: 0"
                        android:textSize="16sp"
                        android:textColor="#4CAF50"
                        android:paddingVertical="6dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E8ECF1" />

                    <TextView
                        android:id="@+id/tvPendientes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⏳ Pendientes: 0"
                        android:textSize="16sp"
                        android:textColor="#FF5252"
                        android:paddingVertical="6dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>